# Generated credentials are appended by llmops/stack.sh init.
# Do not commit the generated .env or publish rendered Compose configuration.
LITELLM_PORT=4000
POSTGRES_MEMORY=1g
# POSTGRES_PASSWORD, LITELLM_DB_PASSWORD, and LITELLM_SALT_KEY are generated by init.
# Keep these values with database backups; changing env vars does not rotate DB roles.
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MEMORY=4g
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# For reproducible model artifacts, set an approved Hugging Face commit SHA.
VLLM_MODEL_REVISION=main
VLLM_SERVED_MODEL_NAME=local-model
VLLM_MAX_MODEL_LEN=4096
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_GPU_COUNT=1
VLLM_MEMORY=16g
VLLM_SHM_SIZE=2gb
# Optional Hugging Face token for gated models; passed only to vLLM.
HF_TOKEN=
